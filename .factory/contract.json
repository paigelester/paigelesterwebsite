{
  "$schema": "https://raw.githubusercontent.com/paigelester/botalot/main/schemas/contract.schema.json",
  "botalot": "1.3.0",
  "stacks": ["typescript", "nextjs"],
  "commands": {
    "setup": ["npm install"],
    "verify": [
      "npm run lint",
      "npm run format:check",
      "npm run typecheck",
      "npm test",
      "npm run build"
    ],
    "run": "npm run dev"
  },
  "workflows": ["implement", "route", "fix-pr"],
  "reviews": [
    {
      "paths": ["**"],
      "run": ["code"]
    }
  ],
  "limits": {
    "minutesPerRun": 60,
    "maxRuns": 2,
    "pauseAtQuotaPercent": 80
  }
}
